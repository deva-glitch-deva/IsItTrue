# Everything is optional. With zero keys the app runs in full demo mode.
# Add keys to upgrade individual pipeline stages automatically.

# Primary LLM: claim extraction + evidence comparison (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional secondary OpenAI-compatible provider. Used as a fallback if OPENAI_API_KEY is absent.
OTHER_AI_API_KEY=
OTHER_AI_BASE_URL=
OTHER_AI_MODEL=

# Speech to text (OpenAI-compatible). Whisper transcribes uploaded audio/video.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# Web search. Tavily is used when SEARCH_API_KEY is set.
# Without a key, Wikipedia (free, no key) still supplies live clickable sources.
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily
TAVILY_SEARCH_DEPTH=basic

# Shared claim cache + trending (Postgres)
DATABASE_URL=

# Optional: public site URL used inside share cards
NEXT_PUBLIC_SITE_URL=http://localhost:3000
