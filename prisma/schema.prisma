generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id            String   @id
  cacheKey      String   @unique
  normalized    String
  language      String
  inputType     String
  rawInput      String
  result        Json
  serious       Boolean  @default(false)
  sensitive     Boolean  @default(false)
  category      String?
  checks        Int      @default(1)
  recentChecks  Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastCheckedAt DateTime @default(now())

  @@index([createdAt])
  @@index([lastCheckedAt])
  @@index([checks])
  @@index([recentChecks])
}
